{
  "name": "safevixai-frontend",
  "version": "1.0.0",
  "description": "SafeVixAI - AI Emergency Navigator PWA (IIT Madras Road Safety Hackathon 2026)",
  "sideEffects": false,
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/copy-public.js",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern '*.js' .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test e2e",
    "test:watch": "jest --watch",
    "analyze": "ANALYZE=true next build",
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "i18n:split": "node scripts/split-namespaces.mjs",
    "i18n:types": "node scripts/generate-i18n-types.mjs",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "i18n:translate": "python scripts/generate-ai-translations.py",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@gsap/react": "2.1.2",
    "@huggingface/transformers": "4.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-virtual": "3.14.10",
    "autoprefixer": "10.5.4",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fast-deep-equal": "3.1.3",
    "gsap": "3.15.0",
    "i18next": "26.4.0",
    "idb": "8.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "1.33.0",
    "maplibre-gl": "6.4.1",
    "next": "^16.3.1",
    "next-view-transitions": "0.3.5",
    "postcss": "8.5.26",
    "posthog-js": "1.418.6",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "^0.185.1",
    "typescript": "6.0.3",
    "use-debounce": "10.1.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/bundle-analyzer": "16.3.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "eslint": "10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "30.4.1",
    "ts-jest": "29.4.12"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "ws": "^8.20.2",
    "brace-expansion": "^5.0.9",
