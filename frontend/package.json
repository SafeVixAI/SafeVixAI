    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "2.107.0",
    "@tanstack/react-virtual": "3.14.8",
    "autoprefixer": "10.4.20",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fast-deep-equal": "3.1.3",
    "gsap": "3.15.0",
    "i18next": "26.3.1",
    "idb": "8.0.3",
    "lenis": "^1.3.23",
    "lucide-react": "1.17.0",
    "maplibre-gl": "5.22.0",
    "next": "^16.2.12",
    "next-view-transitions": "0.3.5",
    "postcss": "8.5.14",
    "posthog-js": "1.382.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.8",
    "sonner": "2.0.7",
    "swr": "2.4.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.10",
